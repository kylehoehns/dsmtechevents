---
// How to get a group or event listed. The footer's "Add your group" button
// lands here, so nobody is surprised by their mail app opening.
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site.mjs';
import { loadData } from '../lib/data.mjs';

const subject = 'Add to DSM Tech Events';
const body = [
  'Group or event name:',
  'Meetup link (or website / calendar link):',
  'For a one-off event — date, time, venue and sign-up link:',
  'Anything else we should know:',
].join('\n\n');
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
// Copy-paste snippets for the organizer badge. Meetup's group description
// takes plain text only, so that one is just a sentence and the link.
const badgeImg = new URL('/badge.png', site.url).href;
const snippets = [
  { label: 'HTML (your website)', code: `<a href="${site.url}/"><img src="${new URL('/badge.svg', site.url).href}" width="300" height="64" alt="Find more Des Moines tech events"></a>` },
  { label: 'Markdown (a README)', code: `[![Find more Des Moines tech events](${badgeImg})](${site.url}/)` },
  { label: 'Plain text (Meetup description)', code: `Find more Des Moines tech meetups and conferences: ${site.url}` },
];
---
<Layout nav="add" updatedAt={loadData().updatedAt} headTitle="Add your group or event · DSM Tech Events"
  description="Get your Des Moines tech meetup, user group, conference or one-off event listed on DSM Tech Events. Send us your Meetup link, or the details of a single event.">
  <div class="page-head"><h1>Add your group or event</h1></div>

  <div class="add-page">
    <p class="lede">
      DSM Tech Events lists public tech meetups, user groups and conferences in and around Des Moines.
      One-off events are welcome too: a conference, a workshop, a hack day.
      We link to your Meetup page or site, and people sign up there, not here.
    </p>

    <section>
      <h2>What fits</h2>
      <ul>
        <li>Tech-focused: software, data, security, product, design, hardware, and so on.</li>
        <li>Open to the public. No members-only or invite-only events.</li>
        <li>In the Des Moines area, or online and run by a local group.</li>
      </ul>
    </section>

    <section>
      <h2>What to send</h2>
      <ul>
        <li>Your group or event's name.</li>
        <li>For a group: its Meetup link. Not on Meetup? A website or public calendar link works too.</li>
        <li>For a one-off event: the date, time, venue, and a link where people can sign up or learn more.</li>
      </ul>
      <p>If your group is on Meetup, that's all. New events are pulled in automatically four times a day.</p>
    </section>

    <section class="email-box" aria-labelledby="email-h">
      <h2 id="email-h">Send it here</h2>
      <p class="address"><span id="add-email">{site.email}</span></p>
      <div class="email-actions">
        <button type="button" class="copy btn btn-outline" id="copy-email" data-copy={site.email}>Copy address</button>
        <a class="primary btn btn-solid" href={mailto}>Open in your email app <span aria-hidden="true">→</span></a>
        <span class="copied" id="copied" role="status"></span>
      </div>
    </section>

    <section class="badge-kit" aria-labelledby="badge-h">
      <h2 id="badge-h">Already listed? Point your members here</h2>
      <p>Add this to your group's site or README so people can find the rest of the Des Moines tech scene.</p>
      <p><img src="/badge.svg" width="300" height="64" alt="Find more Des Moines tech events" /></p>
      {snippets.map((sn, i) => (
        <div class="snippet">
          <div class="snippet-head">
            <b>{sn.label}</b>
            <button type="button" class="btn btn-solid btn-small" data-copy-from={`snippet-${i}`}>Copy</button>
          </div>
          <pre><code id={`snippet-${i}`}>{sn.code}</code></pre>
        </div>
      ))}
    </section>

    <p class="dev-note">
      Prefer GitHub? The site is open source. <a href={`${site.repo}#adding-things`}>Open a pull request</a> with your group in <code>data/groups.yaml</code> or your event in <code>data/events.yaml</code>.
    </p>
  </div>
</Layout>

<script>
  // Copy buttons: the email address, and each badge snippet. Without
  // clipboard access, select the text so it can be copied by hand.
  const note = document.getElementById('copied')!;
  async function copy(button: HTMLButtonElement, text: string, el: HTMLElement, status: (msg: string) => void) {
    try {
      await navigator.clipboard.writeText(text);
      status('Copied');
    } catch {
      const range = document.createRange();
      range.selectNodeContents(el);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      status('Selected. Copy it from here.');
    }
  }
  const emailBtn = document.getElementById('copy-email') as HTMLButtonElement;
  emailBtn.addEventListener('click', () => copy(emailBtn, emailBtn.dataset.copy!, document.getElementById('add-email')!, (msg) => {
    note.textContent = msg;
    setTimeout(() => { note.textContent = ''; }, 3000);
  }));
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-from]')) {
    const code = document.getElementById(btn.dataset.copyFrom!)!;
    btn.addEventListener('click', () => copy(btn, code.textContent!, code, (msg) => {
      btn.textContent = msg === 'Copied' ? 'Copied' : 'Selected';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    }));
  }
</script>
