---
// A printable flyer of the next four weeks, for a coffee-shop or coworking
// corkboard: black ink on one letter page, a QR code to the site, and
// tear-off tabs. On screen it shows the same sheet with a Print button.
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { weekday, day, month, shortTime, monthName, dateRange } from '../lib/format.mjs';
import { site } from '../lib/site.mjs';

const { upcoming } = loadData();
const DAYS = 28;
const MAX = 11; // what fits above the QR code and tear-off tabs on one page
const horizon = Date.now() + DAYS * 86_400_000;
// Dates matter on paper, so every date of a repeating meetup gets its line.
const rows = upcoming.filter((e) => Date.parse(e.start) < horizon).slice(0, MAX);
const more = upcoming.filter((e) => Date.parse(e.start) < horizon).length - rows.length;
// The label before the title: the hosts, plus "conference" for headliners.
const label = (e: any) => (e.groupIds.length && e.headliner ? `${e.hostsLabel} · conference` : e.hostsLabel);
// The date column carries the dates, so this is only the hours.
const hours = (e: any) => (e.allDay ? 'All day' : `${shortTime(e.start)}–${shortTime(e.end)}`);
const dates = (e: any) => (e.multiDay ? dateRange(e.start, e.end) : `${month(e.start)} ${day(e.start)}`);
const where = (e: any) => (e.online ? 'Online' : e.venue ?? 'Venue TBA');
const qr = await QRCode.toString(site.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#000000', light: '#0000' } });
const siteHost = new URL(site.url).host;
const span = rows.length ? `${month(rows[0].start)} ${day(rows[0].start)} – ${month(rows.at(-1).start)} ${day(rows.at(-1).start)}` : monthName(new Date().toISOString(), true);
---
<Layout bare noindex headTitle={`Printable flyer · ${site.name}`} description="A one-page flyer of upcoming Des Moines tech meetups to print and pin up.">
  <main class="print-page">
    <nav class="print-tools" aria-label="Flyer">
      <a href="/">← Back to events</a>
      <button type="button" class="btn btn-solid" id="print-btn">Print this flyer</button>
      <span>Letter size, black and white. Pin it up somewhere techies get coffee.</span>
    </nav>

    <article class="sheet">
      <span class="tape" aria-hidden="true" /><span class="tape" aria-hidden="true" />
      <header class="sheet-head">
        <p class="kicker">Des Moines tech meetups · {span}</p>
        <h1>{site.name}</h1>
        <p class="lede">Public meetups for developers, data people, designers and the tech-curious. Show up, say hi.</p>
      </header>

      {rows.length > 0 ? (
        <ol class="lineup">
          {rows.map((e) => (
            <li class:list={{ headliner: e.headliner }} data-end={e.end}>
              <span class="row-date"><b>{weekday(e.start)}</b> {dates(e)}</span>
              <span class="row-time">{hours(e)}</span>
              <span class="what"><b>{label(e)}</b> {e.title}</span>
              <span class="row-where">{where(e)}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="lede">A quiet stretch: nothing posted for the next four weeks yet.</p>
      )}

      <footer class="sheet-foot">
        <div class="qr" set:html={qr} />
        <p>
          <b>{more > 0 ? `+ ${more} more, and every group` : 'Every group, every date'}:</b>
          <span class="url">{siteHost}</span>
        </p>
      </footer>

      <p class="tear-note" aria-hidden="true">Tear one off ↓</p>
      <div class="tabs" aria-hidden="true">
        {Array.from({ length: 8 }, () => <span>{siteHost}</span>)}
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* On screen the sheet is taped to the site's paper, in either theme; the sheet itself is always white with black ink. */
  .print-page { padding: 24px 16px 48px; font-family: var(--sans); overflow-x: clip; } /* the corner tape hangs past a phone's edge; no sideways scroll */
  .print-tools { max-width: 8.5in; margin: 0 auto 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; font: 600 13px/1.3 var(--mono); }
  .print-tools a { color: inherit; }
  .print-tools span { color: var(--ink-soft); }

  .sheet { position: relative; display: flex; flex-direction: column; box-sizing: border-box; width: 8.5in; max-width: 100%; min-height: 11in; margin: 0 auto; padding: 0.5in 0.55in 1.5in; background: #fff; color: #000; box-shadow: 0 2px 14px rgba(0, 0, 0, 0.18); }
  /* masking tape centred on each top corner, holding it down (the material is .tape::before in global.css);
     the toolbar's 40px gap above the sheet leaves room for the strips' top ends */
  .sheet .tape { position: absolute; top: -12px; left: -38px; width: 76px; height: 24px; transform: rotate(-42deg); filter: drop-shadow(0 1px 1.5px rgba(0, 0, 0, 0.28)); }
  .sheet .tape + .tape { left: auto; right: -38px; transform: rotate(38deg); }
  .sheet-head { border-bottom: 6px double #000; padding-bottom: 12px; }
  .kicker { margin: 0 0 6px; font: 700 13px/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
  .sheet h1 { margin: 0; font: 900 72px/0.82 var(--display); text-transform: uppercase; }
  .lede { margin: 10px 0 0; font-size: 15px; line-height: 1.4; max-width: 46em; }

  .lineup { list-style: none; margin: 14px 0 0; padding: 0; }
  .lineup li { display: grid; grid-template-columns: 1.15in 0.95in 1fr; grid-template-areas: 'd t what' 'd t w'; column-gap: 12px; padding: 7px 0; border-bottom: 1.5px dashed #000; break-inside: avoid; }
  .lineup .row-date { grid-area: d; font: 900 20px/1 var(--display); text-transform: uppercase; }
  .lineup .row-time { grid-area: t; font: 700 13px/1.4 var(--mono); }
  .lineup .what { grid-area: what; font-size: 14.5px; line-height: 1.3; }
  .lineup .what b { font: 900 16px/1 var(--display); text-transform: uppercase; margin-right: 4px; }
  .lineup .row-where { grid-area: w; font: 500 12px/1.4 var(--mono); }
  /* a conference gets a box: an outline, no fill, so it costs no toner */
  .lineup li.headliner { border: 2px solid #000; margin: 3px -10px; padding: 6px 8px; } /* the border sits in the margin, so the columns stay lined up */

  .sheet-foot { margin-top: auto; padding-top: 14px; display: flex; align-items: center; gap: 16px; font-size: 14px; line-height: 1.4; }
  .sheet-foot .qr svg { display: block; width: 0.95in; height: 0.95in; }
  .sheet-foot .url { display: block; font: 900 28px/1 var(--display); text-transform: uppercase; }

  /* tear-off tabs along the bottom edge */
  .tabs { position: absolute; left: 0.3in; right: 0.3in; bottom: 0; height: 1.3in; display: grid; grid-template-columns: repeat(8, 1fr); border-top: 1.5px dashed #000; }
  .tabs span { display: flex; align-items: center; justify-content: center; border-left: 1.5px dashed #000; writing-mode: vertical-rl; transform: rotate(180deg); font: 700 12px/1 var(--mono); }
  .tabs span:last-child { border-left: 0; } /* rotate(180deg) puts each left border on the right */
  .tear-note { position: absolute; right: 0.6in; bottom: calc(1.3in + 6px); margin: 0; font: 400 17px/1 var(--marker); transform: rotate(-4deg); }

  @media screen and (max-width: 8.6in) { .sheet { min-height: 0; } .sheet h1 { font-size: 48px; } .sheet-foot { flex-wrap: wrap; } .sheet-foot p { flex: 1 1 240px; } /* under the QR code when the URL (240px at most) won't fit beside it */ .sheet-foot .url { font-size: clamp(18px, 6vw, 28px); } .lineup li { grid-template-columns: 1fr; grid-template-areas: 'd' 't' 'what' 'w'; } }

  @page { size: letter; margin: 0; }
  @media print {
    html:has(.print-page), html:has(.print-page) body { background: #fff; }
    .print-page { padding: 0; }
    .print-tools, .sheet .tape { display: none; }
    .sheet { width: 8.5in; height: 11in; min-height: 0; box-shadow: none; overflow: hidden; }
  }
</style>

<script>
  // Built ahead of time: drop anything that has already ended.
  for (const li of document.querySelectorAll<HTMLElement>('.lineup li[data-end]')) {
    if (Date.parse(li.dataset.end!) <= Date.now()) li.remove();
  }
  document.getElementById('print-btn')!.addEventListener('click', () => window.print());
</script>
