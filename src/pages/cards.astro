---
// The card pool: a card for every event the home page's list doesn't print in
// full (repeat dates, far-off events, past ones). The calendar's day panel
// fetches it on first use (app.js), which keeps ~120KB of hidden cards out of
// the home page; sw.js saves it for offline. Not a page for people: no
// styles, kept out of search.
//
// It also holds a one-line row for every past event, archive included, which
// a search shows in its "Past" section (app.js). Events ending in the next
// two days get a row too, with data-after, so one that ends while a search or
// a group's view is open moves to Past instead of vanishing.
import EventCard from '../components/EventCard.astro';
import EventRow from '../components/EventRow.astro';
import { loadData } from '../lib/data.mjs';
import { splitEvents, pastEvents } from '../lib/pool.mjs';
import { dayKey } from '../lib/format.mjs';

const data = loadData();
const { pooled, today } = splitEvents(data);
const pastRows = pastEvents({ ...data, past: [...data.endingSoon, ...data.past] });
const year = (e: { start: string }) => (dayKey(e.start).slice(0, 4) === today.slice(0, 4) ? '' : `, ${dayKey(e.start).slice(0, 4)}`);
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="robots" content="noindex"><title>Card pool</title></head>
<body><ul>{pooled.map((e) => <EventCard event={e} byId={data.byId} />)}</ul>
<ol id="past">{pastRows.map((e) => <EventRow event={e} kind="past" byId={data.byId} year={year(e)} data-after={data.endingSoon.includes(e) ? e.end : undefined} />)}</ol></body>
</html>
