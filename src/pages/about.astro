---
// Who runs this, how the listings get here, and what to do when one is wrong.
// Linked from the footer, not the top nav.
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { site } from '../lib/site.mjs';

const { groups, updatedAt } = loadData();
---
<Layout nav="about" updatedAt={updatedAt} headTitle="About · DSM Tech Events"
  description="DSM Tech Events is one calendar of every public tech meetup, user group and conference in the Des Moines area, pulled automatically from each group's own page.">
  <div class="page-head"><h1>About</h1></div>

  <div class="add-page">
    <p class="lede">
      DSM Tech Events puts every public tech meetup, user group and conference in the Des Moines area on one calendar,
      so you don't have to check {groups.length} different pages to find out what's on this week.
    </p>

    <section>
      <h2>How it works</h2>
      <ul>
        <li>Events come straight from each group's Meetup page or website and update on their own. Conferences and one-off events are added by hand.</li>
        <li>We only point the way. You RSVP or register on the group's own page, and the group runs the event.</li>
        <li>We're not affiliated with any of the groups. If a listing looks wrong, the group's page is the one to trust. Let us know and we'll fix it.</li>
      </ul>
    </section>

    <section>
      <h2>Who runs it</h2>
      <p>
        Made by <a href="https://www.kylehoehns.com/">Kyle Hoehns</a>,
        organizer of the <a href="https://www.cijug.net/">Central Iowa Java Users Group</a> and a frequent speaker at local user groups.
        The code is <a href={site.repo}>open source on GitHub</a>.
      </p>
    </section>

    <section>
      <h2>Put it on a screen, or a wall</h2>
      <p>
        Have a TV in your office, coworking space or meetup venue?
        Open <a href="/tv/">dsmtechevents.com/tv</a> full screen. It rotates through what's coming up, each with a QR code to sign up, and keeps itself current.
        Prefer paper? <a href="/print/">Print a flyer</a> of the next four weeks for a corkboard.
      </p>
    </section>

    <section>
      <h2>Privacy</h2>
      <p>No accounts and no tracking cookies. Cloudflare Web Analytics counts visits, and the site counts which RSVP and event links get clicked, so groups can see how many people it sends them. Neither identifies anyone.</p>
    </section>

    <section>
      <h2>Get in touch</h2>
      <p>
        Corrections, ideas or questions: <a href={`mailto:${site.email}`}>{site.email}</a>.
        Want your group or event listed? <a href="/add/">Here's how</a>.
      </p>
    </section>
  </div>
</Layout>
