---
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { fullDate, time } from '../lib/format.mjs';

const { groups, updatedAt } = loadData();
const sorted = [...groups].sort((a, b) =>
  (a.nextEvent?.start ?? '9999').localeCompare(b.nextEvent?.start ?? '9999') || a.name.localeCompare(b.name));
const initials = (name: string) => name.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
---
<Layout title="Groups" active="groups" updatedAt={updatedAt}>
  <section class="intro">
    <h1>The groups</h1>
    <p>{groups.length} Des Moines tech communities. Pick one, show up, say hi.</p>
  </section>

  <div class="group-grid">
    {sorted.map((g) => (
      <article class="group" style={`--c: ${g.color}`}>
        <div class="group-head">
          {g.logo
            ? <img class="logo" src={g.logo} alt="" loading="lazy" width="56" height="56" />
            : <span class="logo initials" aria-hidden="true">{initials(g.name)}</span>}
          <div>
            <h2>{g.name}</h2>
            <div class="tags">{g.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
          </div>
        </div>
        <p class="next">
          {g.nextEvent
            ? <>Next: <a href={g.nextEvent.url} target="_blank" rel="noopener">{g.nextEvent.title}</a><br /><span class="muted">{fullDate(g.nextEvent.start)} · {time(g.nextEvent.start)}</span></>
            : <span class="muted">Nothing scheduled yet.</span>}
        </p>
        <div class="group-links">
          <a href={`/?group=${g.id}`}>Events</a>
          {g.meetupUrl && <a href={g.meetupUrl} target="_blank" rel="noopener">Meetup ↗</a>}
          {g.website && <a href={g.website} target="_blank" rel="noopener">Website ↗</a>}
        </div>
      </article>
    ))}
  </div>
</Layout>
