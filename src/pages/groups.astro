---
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { weekday, day, month, shortTime } from '../lib/format.mjs';

const { groups, updatedAt } = loadData();
// Groups with something on the books first, soonest first.
const sorted = [...groups].sort((a, b) =>
  (a.nextEvent?.start ?? '9999').localeCompare(b.nextEvent?.start ?? '9999') || a.short.localeCompare(b.short));
const when = (e: any) => `${weekday(e.start)} ${month(e.start)} ${day(e.start)}`;
---
<Layout title="Groups" nav="groups" updatedAt={updatedAt}
  blurb={`${groups.length} Des Moines tech groups. Pick one, show up, say hi.`}>
  <div class="board">
    {sorted.map((g, i) => (
      <article class:list={['flyer', { 'has-logo': !!g.logo }]}>
        {g.logo && <img class="logo-img" src={g.logo} alt="" loading="lazy" width="60" height="60" />}
        <h2>{g.short}</h2>
        {g.showFullName && <p class="full">{g.name}</p>}
        <p class="tags">{g.tags.map((t: string) => <b>{t}</b>)}</p>
        <p class="next">
          {g.nextEvent
            ? <><span class="nd">Next: {when(g.nextEvent)}</span><span class="nt">{g.nextEvent.title}</span>{g.nextEvent.online ? 'Online' : `@ ${g.nextEvent.venue ?? 'TBA'}`} · {g.nextEvent.allDay ? 'All day' : shortTime(g.nextEvent.start)}</>
            : <><span class="nd idle">Nothing scheduled</span>Nothing posted yet. Check their page.</>}
        </p>
        {g.lastEvent && (
          <p class="last">Last event {month(g.lastEvent.start)} {day(g.lastEvent.start)}{g.lastEvent.going ? ` · ${g.lastEvent.going} went` : ''}</p>
        )}
        <div class="links">
          {g.upcomingCount > 0 && <a class="primary" href={`/?group=${g.id}`}>{g.upcomingCount} {g.upcomingCount === 1 ? 'event' : 'events'}</a>}
          {g.meetupUrl && <a href={g.meetupUrl} target="_blank" rel="noopener">Meetup ↗</a>}
          {g.website && <a href={g.website} target="_blank" rel="noopener">Website ↗</a>}
        </div>
      </article>
    ))}
  </div>
</Layout>
