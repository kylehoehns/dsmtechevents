---
import GroupBoard from '../components/GroupBoard.astro';
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';

const { groups, updatedAt } = loadData();
---
<Layout nav="groups" updatedAt={updatedAt}
  headTitle="Des Moines tech meetup groups · DSM Tech Events"
  description={`${groups.length} Des Moines and central Iowa tech user groups: Python, Java, .NET, AI, AWS, security, UX and more, with each one's next meetup.`}>
  <h1 class="sr-only">Des Moines tech groups</h1>
  <GroupBoard groups={groups} />
  <script>import '../scripts/catch-up.js';</script>
</Layout>
