---
import OutArrow from '../components/OutArrow.astro';
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { weekday, day, month, shortTime, plural } from '../lib/format.mjs';

const { groups, updatedAt } = loadData();
// Alphabetical by the name on the card, so a group is easy to find.
const sorted = [...groups].sort((a, b) => a.short.localeCompare(b.short, 'en', { sensitivity: 'base' }));
const when = (e: any) => `${weekday(e.start)} ${month(e.start)} ${day(e.start)}`;
// A group with no logo gets a monogram tile instead, so every card lines up:
// "Iowans of Things" -> "IoT" (small joining words stay lowercase).
const monogram = (name: string) => name.split(/\s+/).filter(Boolean)
  .map((w) => (/^(of|the|and|&|for|in)$/i.test(w) ? w[0].toLowerCase() : w[0].toUpperCase())).join('').slice(0, 4);
---
<Layout nav="groups" updatedAt={updatedAt}
  headTitle="Des Moines tech meetup groups · DSM Tech Events"
  description={`${groups.length} Des Moines and central Iowa tech user groups, including ${groups.slice(0, 5).map((g) => g.name).join(', ')} and more, with each one's next meetup.`}>
  <h1 class="sr-only">Des Moines tech groups</h1>
  <div class="board">
    {sorted.map((g, i) => (
      <article id={g.id} data-groups={g.id} class="flyer has-logo">
        <div class="flyer-head">
          {g.logo
            ? <img class="logo-img" src={g.logoThumb} alt="" loading="lazy" width="60" height="60" />
            : <span class="logo-img logo-mono" aria-hidden="true">{monogram(g.short)}</span>}
          <h2>{g.short}{!g.showFullName && g.name !== g.short && <span class="sr-only"> ({g.name})</span>}</h2>
          {g.showFullName && <p class="full">{g.name}</p>}
          {(g.members || g.pastCount) && (
            <p class="facts">{[g.members && `${g.members.toLocaleString('en-US')} members`, g.pastCount && `${g.pastCount} meetups`].filter(Boolean).join(' · ')}</p>
          )}
        </div>
        <p class="next">
          {g.nextEvent
            ? <><span class="next-when">Next: {when(g.nextEvent)}</span><span class="sr-only">, </span><span class="next-title">{g.nextEvent.title}</span><span class="sr-only">, </span>{g.nextEvent.online ? 'Online' : `@ ${g.nextEvent.venue ?? 'Venue TBA'}`} · {g.nextEvent.allDay ? 'All day' : shortTime(g.nextEvent.start)}</>
            : <><span class="next-when idle">Nothing scheduled</span>Check their page for what's next.</>}
        </p>
        {g.lastEvent && (
          <p class="last">Last event {month(g.lastEvent.start)} {day(g.lastEvent.start)}{g.lastEvent.going ? ` · ${g.lastEvent.going} went` : ''}</p>
        )}
        <div class="links">
          {g.upcomingCount > 0
            ? <a class="primary btn btn-solid btn-small" href={`/?group=${g.id}`}>{plural(g.upcomingCount, 'event')}<span class="sr-only"> from {g.short}</span></a>
            : g.lastEvent && <a class="btn btn-outline btn-small" href={`/?group=${g.id}`}>Past events<span class="sr-only"> from {g.short}</span></a>}
          {g.meetupUrl && <a class="btn btn-outline btn-small" href={g.meetupUrl} target="_blank" rel="noopener" data-click="meetup">Meetup<span class="sr-only"> page for {g.short} (opens in new tab)</span> <OutArrow /></a>}
          {g.website && <a class="btn btn-outline btn-small" href={g.website} target="_blank" rel="noopener" data-click="website">Website<span class="sr-only"> for {g.short} (opens in new tab)</span> <OutArrow /></a>}
        </div>
      </article>
    ))}
  </div>
</Layout>
