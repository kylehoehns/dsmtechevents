---
// Lobby TV mode: full-screen posters of what's coming up, for a screen at a
// coworking space or a meetup venue. Linked from /organizers/, kept out
// of search. It reloads itself hourly to pick up the 4x-a-day data refresh.
//
// Slides: a "Coming up" overview, then one poster per event with a QR code
// to its Meetup (or conference) page. ← → step, space pauses.
// Each change is screen-printed in (src/styles/tv-fx.css). Reduced motion,
// or ?fx=off for a TV stick too slow for it, gets a plain swap.
//
// Event mode, /tv/?event=<id>, shows ONE event on a host venue's lobby
// screen, then what's next (src/scripts/tv-event.ts; /organizers/ makes
// the link). It runs in the browser from the event data embedded below.
// noindex covers it too: it's a screen display that points out, not a page.
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import '../styles/tv-fx.css';
import { loadData } from '../lib/data.mjs';
import { weekday, day, month, shortRange, shortTime, dateRange, lastDay, lineup, DAY } from '../lib/format.mjs';
import { toScript } from '../lib/jsonld.mjs';
import { site } from '../lib/site.mjs';

const { upcoming, events: all, allGroups } = loadData();
const DAYS = 21;
const SHOWN = 10;
const horizon = Date.now() + DAYS * 86_400_000;
const soon = upcoming.filter((e) => !e.repeat && Date.parse(e.start) < horizon);
// Always show something, even in a quiet stretch.
const events = (soon.length >= 3 ? soon : upcoming.filter((e) => !e.repeat)).slice(0, SHOWN);

// On the overview slide: one code to the whole site.
const siteQr = await QRCode.toString(site.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1b2b', light: '#0000' } });

const whereOf = (e: { online?: boolean; venue?: string; address?: string }) => (e.online ? 'Online' : [e.venue, e.address].filter(Boolean).join(' · ') || 'Venue TBA');
const slides = await Promise.all(events.map(async (e) => ({
  e,
  hosts: e.hostsLabel,
  where: whereOf(e),
  qr: e.url ? await QRCode.toString(e.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1b2b', light: '#0000' } }) : null,
})));

// Event mode's data: every upcoming event, plus any that ended in the last
// day (a screen reloading just after its event gets the closing slide, not
// "not on the calendar"). The browser filters by the real clock.
const eventData = {
  site: site.url,
  groups: Object.fromEntries(allGroups.map((g) => [g.id, g.short])),
  events: all.filter((e) => Date.parse(e.end) > Date.now() - DAY).map((e) => ({
    id: e.id, title: e.title, start: e.start, end: e.end, allDay: !!e.allDay, multiDay: !!e.multiDay, repeat: !!e.repeat,
    hosts: e.hostsLabel, groups: e.groupIds, where: whereOf(e), url: e.url ?? null, photo: e.photo?.large ?? null,
    talks: lineup(e.description),
  })),
};
---
<Layout bare noindex headTitle={`TV · ${site.name}`}>
  <div class="tv" id="tv">
    <header class="tv-top">
      <span class="tv-logo misprint" data-t={site.name}>{site.name}</span>
      <span class="tv-site">{new URL(site.url).host}</span>
      <time class="tv-clock" id="tv-clock"></time>
    </header>

    <main class="tv-stage">
      <section class="slide overview is-on">
        <div class="overview-head">
          <h1 class="misprint" data-t="Coming up">Coming up</h1>
          <div class="qr site-qr">
            <div class="qr-code" set:html={siteQr} />
            <span>Every event</span>
          </div>
        </div>
        <p class="tv-empty" hidden>Nothing on the calendar right now. New events show up here as groups post them.</p>
        <ol>
          {slides.slice(0, 7).map(({ e, hosts }) => (
            <li class:list={{ headliner: e.headliner }} data-end={e.end} data-start={e.start} data-days={e.multiDay && !e.allDay ? '' : undefined}>
              <span class="row-date">{e.multiDay
                ? <><b>{weekday(e.start)}–{weekday(`${lastDay(e.start, e.end)}T17:00:00Z`)}</b> <span>{dateRange(e.start, e.end)}</span></>
                : <><b>{weekday(e.start)}</b> {month(e.start)} {day(e.start)}</>}</span>
              <span class="row-group">{hosts}</span>
              <span class="row-title"><span class="when-tag" hidden></span>{e.title}</span>
              <span class="row-time">{e.allDay ? 'All day' : `${shortTime(e.start)}–${shortTime(e.end)}`}</span>
            </li>
          ))}
        </ol>
      </section>

      {slides.map(({ e, hosts, where, qr }) => (
        <section class:list={['slide', 'poster-slide', { headliner: e.headliner }]} data-end={e.end} data-start={e.start} data-days={e.multiDay && !e.allDay ? '' : undefined}>
          <div class="date-block">
            <span class="dow">{weekday(e.start)}</span>
            <span class="num misprint" data-t={day(e.start)}>{day(e.start)}</span>
            <span class="mon">{month(e.start)}</span>
            <span class="when-tag" hidden></span>
          </div>
          <div class="info">
            <p class="hosts">{hosts}</p>
            <h2>{e.title}</h2>
            <p class="time">{shortRange(e)}</p>
            <p class="where">{where}</p>
            {e.going > 0 && <p class="going"><b>{e.going}</b> going</p>}
          </div>
          {(e.photo || qr) && (
            <div class="tv-side">
              {e.photo && <img class="tv-photo" src={e.photo.large} {...(e.photo.large.includes('meetupstatic.com') ? { width: 600, height: 338 } : {})} alt="" />}
              {qr && (
                <div class="qr">
                  <div class="qr-code" set:html={qr} />
                  <span>{e.url.includes('meetup.com') ? 'Scan to RSVP' : 'Scan for details'}</span>
                </div>
              )}
            </div>
          )}
        </section>
      ))}
    </main>

    <div class="tv-progress"><span id="tv-bar"></span></div>
  </div>
  {/* toScript escapes "<", so an event title can't close this tag. */}
  <script type="application/json" id="tv-data" set:html={toScript(eventData)} />
</Layout>

<style is:global>
  /* The TV is always the dark flyer, whatever the device prefers. */
  html:has(.tv) { background: #141217; cursor: none; }
  .tv {
    --bg: #1d1c22; --ink: #ece6da; --soft: #bdb6aa; --pink: #e0609f; --blue: #93c2ff; --misprint: #c04f87;
    position: fixed; inset: 0; display: grid; grid-template-rows: auto 1fr auto;
    background: var(--bg); color: var(--ink); overflow: hidden;
    padding: 3vh 4vw 2vh; font-family: var(--sans);
    animation: tv-drift 600s ease-in-out infinite alternate; /* nudges everything a few px against burn-in */
  }
  @keyframes tv-drift { from { translate: -6px -4px; } to { translate: 6px 4px; } }
  .tv .misprint::before { color: var(--misprint); mix-blend-mode: normal; }
  .tv-top { display: flex; align-items: baseline; gap: 2vw; border-bottom: 3px solid #5d5966; padding-bottom: 1.2vh; }
  .tv-logo { font: 900 5vh/0.9 var(--display); text-transform: uppercase; color: var(--blue); }
  .tv-site { font: 700 2.2vh/1 var(--mono); color: var(--soft); }
  .tv-clock { margin-left: auto; font: 700 3vh/1 var(--mono); }

  .tv-stage { position: relative; min-height: 0; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.8s ease; display: flex; }
  .slide.is-on { opacity: 1; }

  .overview { flex-direction: column; gap: 2vh; padding-top: 3vh; }
  .overview-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 3vw; }
  .site-qr .qr-code svg { width: 13vh; height: 13vh; }
  .overview h1 { margin: 0; font: 900 9vh/0.85 var(--display); text-transform: uppercase; color: var(--ink); }
  .tv-empty { margin: 0; font: 600 3.4vh/1.3 var(--sans); color: var(--soft); }
  .overview ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4vh; }
  .overview li { display: grid; grid-template-columns: 14vw 14vw 1fr auto; align-items: baseline; gap: 2vw; padding-bottom: 1.2vh; border-bottom: 2px dashed #5d5966; font-size: 3.2vh; }
  .overview li.headliner .row-title { color: var(--pink); }
  .overview .row-date { font: 700 2.8vh/1 var(--mono); }
  .overview .row-date b { color: var(--blue); }
  .overview .row-date span { white-space: nowrap; } /* a range too wide for the column breaks after the weekdays */
  .overview .row-group { font: 900 3.4vh/1 var(--display); text-transform: uppercase; color: var(--pink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .overview .row-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .overview .row-time { font: 600 2.6vh/1 var(--mono); color: var(--soft); }
  /* Happening now / Tonight / Today on a row, hand-stamped like the home list's */
  .overview .when-tag { display: inline-block; margin: 0 1vw 0 0; font: 400 2.6vh/1 var(--marker); background: var(--pink); color: #1d1b2b; padding: 0.5vh 0.6vw 0.2vh; transform: rotate(-3deg); }

  .poster-slide { align-items: center; gap: 4vw; padding: 3vh 0; }
  .poster-slide.headliner { background: var(--pink); color: #1d1b2b; margin: 2vh -4vw; padding: 3vh 4vw; }
  .date-block { display: flex; flex-direction: column; align-items: center; gap: 1.6vh; min-width: 16vw; }
  .date-block .dow, .date-block .mon { font: 900 6vh/1 var(--display); text-transform: uppercase; }
  .date-block .num { font: 900 30vh/0.8 var(--display); color: var(--blue); }
  .poster-slide.headliner .date-block .num { color: #1d1b2b; }
  .poster-slide.headliner .date-block .num::before { color: #0a6cc0; }
  .date-block .when-tag { margin-top: 2vh; font: 400 3.6vh/1 var(--marker); background: var(--pink); color: #1d1b2b; padding: 0.6vh 1vw 0.2vh; transform: rotate(-3deg); }
  .poster-slide.headliner .when-tag { background: #1d1b2b; color: var(--pink); }
  .info { flex: 1; min-width: 0; }
  .info .hosts { margin: 0 0 1vh; font: 900 6vh/0.95 var(--display); text-transform: uppercase; color: var(--pink); }
  .poster-slide.headliner .info .hosts { color: #1d1b2b; }
  .info h2 { margin: 0 0 2.5vh; font: 700 6.4vh/1.08 var(--sans); text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .info .time { margin: 0; font: 700 4vh/1.2 var(--mono); }
  .info .where { margin: 0.6vh 0 0; font: 500 3vh/1.3 var(--mono); color: var(--soft); }
  .poster-slide.headliner .info .where { color: inherit; }
  .info .going { margin: 2.5vh 0 0; font: 600 3vh/1 var(--mono); }
  .info .going b { font: 900 6vh/1 var(--display); vertical-align: -0.6vh; margin-right: 0.6vw; }
  .tv-side { display: flex; flex-direction: column; align-items: center; gap: 3vh; width: 28vw; }
  .tv-side .tv-photo { width: 100%; max-height: 38vh; object-fit: contain; border: 3px solid var(--ink); background: #000; transform: rotate(-1deg); }
  .qr { display: flex; flex-direction: column; align-items: center; gap: 1vh; background: #f3ede1; color: #1d1b2b; padding: 1.6vh; }
  .qr-code svg { display: block; width: 20vh; height: 20vh; }
  .qr span { font: 900 2.6vh/1 var(--display); text-transform: uppercase; }

  /* ---- Event mode (/tv/?event=, src/scripts/tv-event.ts): one event as a
     gig poster, then what's next. Same flyer inks. */
  .ev-slide { align-items: center; gap: 4vw; padding: 3vh 0; }
  .ev-slide .qr-code { width: 22vh; height: 22vh; } /* holds the space while the code draws */
  .ev-slide .qr-code svg { width: 100%; height: 100%; }
  .ev-slide .qr-big .qr-code { width: 34vh; height: 34vh; }
  .ev-slide .qr-big span { font-size: 3vh; max-width: 34vh; text-align: center; line-height: 1.1; }
  .ev-slide .site-qr .qr-code { width: 13vh; height: 13vh; }
  .ev-kicker { margin: 0 0 2vh; font: 700 2.8vh/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--blue); }
  .ev-kicker::before { content: ""; display: inline-block; width: 4vw; height: 0.6vh; margin-right: 1vw; vertical-align: middle; background: var(--pink); }
  .ev-title { margin: 0; font: 900 11vh/0.85 var(--display); text-transform: uppercase; }
  .ev-huge { margin: 0 0 3vh; font: 900 17vh/0.82 var(--display); text-transform: uppercase; color: var(--ink); }

  /* the event: date, words, photo + QR */
  .ev-event .date-block .num { font-size: 34vh; }
  .ev-stamp { margin-top: 2vh; font: 400 4.4vh/1.05 var(--marker); text-align: center; background: var(--pink); color: #1d1b2b; padding: 1vh 1.2vw 0.6vh; transform: rotate(-3deg); max-width: 18vw; }
  .ev-stamp:empty { display: none; }
  .ev-event .info .hosts { font-size: 7vh; }
  .ev-event .info h2 { font-size: 7.4vh; }
  .ev-event .info.has-lineup h2 { font-size: 5.6vh; margin-bottom: 1.6vh; -webkit-line-clamp: 4; }
  .ev-event .info .time { font-size: 4.4vh; }
  .ev-lineup { list-style: none; margin: 3vh 0 0; padding: 2vh 0 0; border-top: 3px solid #5d5966; display: grid; gap: 1.4vh; }
  .ev-lineup { grid-template-columns: auto 1fr; column-gap: 1.6vw; }
  .ev-lineup li { display: grid; grid-template-columns: subgrid; grid-column: 1 / -1; align-items: baseline; }
  .ev-lineup .lt-time { font: 700 3vh/1 var(--mono); color: var(--blue); }
  .ev-lineup .lt-title { font: 600 3.4vh/1.2 var(--sans); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ev-event .tv-side { width: auto; min-width: 26vh; max-width: 30vw; }
  .ev-event .tv-side .qr-code { width: 26vh; height: 26vh; }
  .ev-event .tv-side .tv-photo { max-height: 30vh; }
  .ev-slide > .qr { flex: none; align-self: center; }

  /* closing, "watch for the next one", and the not-on-the-calendar notice */
  .ev-closing, .ev-gone { justify-content: space-between; }
  .ev-closing-text { flex: 1; min-width: 0; }
  .ev-closing-text .hosts { margin: 0 0 1vh; font: 900 5vh/1 var(--display); text-transform: uppercase; color: var(--pink); }
  .ev-closing-text .where { margin: 0; font: 600 3.6vh/1.3 var(--sans); color: var(--soft); }
  .ev-gone .ev-title { font-size: 9vh; margin-bottom: 3vh; text-wrap: balance; }


  /* Up next: a setlist of dates */
  .ev-next-all { flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 3vh; padding-top: 3vh; }
  .ev-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 3vw; }
  .ev-next-all .ev-title { font-size: 9vh; }
  .ev-next { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6vh; }
  .ev-next li { display: grid; grid-template-columns: 15vw 16vw 1fr; gap: 2vw; align-items: baseline; padding-bottom: 1.4vh; border-bottom: 2px dashed #5d5966; }
  .ev-next .row-date { font: 700 3.2vh/1 var(--mono); color: var(--blue); }
  .ev-next .row-group { font: 900 4vh/1 var(--display); text-transform: uppercase; color: var(--pink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ev-next .row-title { font: 600 3.6vh/1.15 var(--sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* the host group's next meetup, as a poster */
  .ev-next-group .ev-head { flex: 1; flex-direction: column; align-items: stretch; gap: 0; min-width: 0; }
  .ev-next-group .ev-head > .ev-closing-text { margin-top: 2vh; }
  .ev-next-group .ev-kicker { font-size: 4vh; }
  .ev-poster { display: flex; align-items: center; gap: 4vw; }
  .ev-poster .date-block .num { font-size: 30vh; }
  .ev-next-group .info h2 { font-size: 7.4vh; }

  .tv-progress { height: 6px; background: #2c2a33; margin-top: 1.4vh; }
  .tv-progress span { display: block; height: 100%; width: 0; background: var(--pink); }
  .tv-progress span.run { animation: tv-bar linear forwards; }
  @keyframes tv-bar { to { width: 100%; } }

  /* A screen hung on its side. The landscape sizes are in vh, which a tall
     screen makes far too big for its width, so sizes here go by vw, and the
     poster stacks: date, then the words, then photo and QR side by side. */
  @media (orientation: portrait) {
    .tv { padding: 2vh 5vw 1.6vh; }
    .tv-top { flex-wrap: wrap; row-gap: 1vh; }
    .tv-logo { font-size: 6vw; }
    .tv-site { font-size: 2.6vw; }
    .tv-clock { font-size: 3.4vw; margin-left: auto; }
    /* narrow phones: the logo's plate offset in px is heavy at this size */
    .tv-logo::before { transform: translate(0.06em, 0.04em); }

    /* rows wrap their titles (two lines at most) under the date, group and time */
    .overview { gap: 2vh; overflow: hidden; }
    .site-qr .qr-code, .ev-slide .site-qr .qr-code, .site-qr .qr-code svg { width: 22vw; height: 22vw; }
    .overview h1 { font-size: 10vw; }
    .tv-empty { font-size: 4.4vw; }
    .overview ol { gap: 1.2vh; }
    .overview li { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.6vh 3vw; padding-bottom: 1vh; font-size: 3.6vw; }
    .overview .row-date { font-size: 3.2vw; }
    .overview .row-group { font-size: 3.6vw; }
    .overview .row-time { font-size: 3.2vw; text-align: right; }
    .overview .when-tag { font-size: 3vw; }
    .overview .row-title { grid-column: 1 / -1; grid-row: 2; white-space: normal; line-height: 1.15; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

    .poster-slide { flex-direction: column; align-items: stretch; justify-content: center; gap: 3vh; }
    .poster-slide.headliner { margin: 1.5vh -5vw; padding: 3vh 5vw; }
    .date-block { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 1vh 4vw; min-width: 0; }
    .date-block .dow, .date-block .mon { font-size: 9vw; }
    .date-block .num { font-size: 26vw; }
    .date-block .when-tag { margin: 0; font-size: 5vw; padding: 0.6vh 2vw 0.2vh; }
    .info { flex: none; }
    .info .hosts { font-size: 8vw; }
    .info h2 { font-size: 8vw; -webkit-line-clamp: 4; }
    .info .time { font-size: 5vw; }
    .info .where { font-size: 3.8vw; }
    .info .going { font-size: 3.8vw; }
    .info .going b { font-size: 7vw; margin-right: 1.5vw; }
    .tv-side { flex-direction: row; justify-content: center; align-items: center; gap: 5vw; width: auto; }
    .tv-side .tv-photo { width: auto; max-width: 52vw; max-height: 26vh; }
    .qr { padding: 2vw; }
    .qr-code svg { width: 30vw; height: 30vw; }
    .qr span { font-size: 3.6vw; }

    /* event mode stacks the same way */
    .ev-slide, .ev-poster { flex-direction: column; align-items: stretch; justify-content: center; gap: 3vh; }
    .ev-slide .qr { align-self: center; }
    .ev-slide .qr-code, .ev-slide .qr-big .qr-code, .ev-event .tv-side .qr-code { width: 30vw; height: 30vw; }
    .ev-event .tv-side { max-width: none; }
    .ev-event .date-block .num, .ev-poster .date-block .num { font-size: 26vw; }
    .ev-stamp { margin: 0; font-size: 5vw; max-width: none; }
    .ev-event .info .hosts { font-size: 8vw; }
    .ev-event .info h2, .ev-next-group .info h2, .ev-event .info.has-lineup h2 { font-size: 7vw; }
    .ev-lineup li { grid-template-columns: 14vw 1fr; }
    .ev-lineup .lt-time, .ev-lineup .lt-title { font-size: 3.6vw; }
    .ev-title, .ev-next-all .ev-title, .ev-gone .ev-title { font-size: 10vw; text-wrap: balance; }
    .ev-huge { font-size: 14vw; }
    .ev-next li { grid-template-columns: auto minmax(0, 1fr); gap: 0.6vh 3vw; }
    .ev-next .row-date, .ev-next .row-group { font-size: 3.6vw; }
    .ev-next .row-title { grid-column: 1 / -1; font-size: 4vw; white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tv { animation: none; }
    .slide { transition: none; }
  }
</style>

<script>
  import { fmt, whenLabel, countdown } from '../lib/format.mjs';
  import { eventMode } from '../scripts/tv-event';

  const SLIDE_MS = 12_000;
  const RELOAD_MS = 60 * 60 * 1000;
  const loadedAt = Date.now();
  // The bare layout skips Layout's footer script, so register the service
  // worker here: a lobby screen that only ever opens /tv/ then has a saved copy
  // to fall back on if the Wi-Fi drops during the hourly reload.
  if ('serviceWorker' in navigator && import.meta.env.PROD) navigator.serviceWorker.register('/sw.js');
  const bar = document.getElementById('tv-bar')!;
  const clock = document.getElementById('tv-clock')!;
  const clockFmt = fmt({ weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const params = new URLSearchParams(location.search);

  // Event mode (?event=<id>) swaps in that event's slides, or, for an id
  // that isn't on the calendar, puts a notice in front of the regular ones.
  const mode = params.has('event')
    ? eventMode(document.querySelector<HTMLElement>('.tv-stage')!, JSON.parse(document.getElementById('tv-data')!.textContent!), params.get('event')!)
    : null;

  // The page is built ahead of time: drop anything that has ended, and label
  // today's and tomorrow's events, on their rows and posters. A headliner's
  // poster always carries the countdown, like its poster on the home page.
  function refresh() {
    const now = Date.now();
    for (const el of document.querySelectorAll<HTMLElement>('[data-end]')) {
      if (el.dataset.end && Date.parse(el.dataset.end) <= now) el.remove();
    }
    for (const s of document.querySelectorAll<HTMLElement>('.overview li, .poster-slide')) {
      const tag = s.querySelector<HTMLElement>('.when-tag')!;
      const label = (s.matches('.poster-slide.headliner') ? countdown : whenLabel)(s.dataset.start!, s.dataset.end!, now, { multiDay: 'days' in s.dataset });
      tag.textContent = label;
      tag.hidden = !label;
    }
    mode?.update(now);
    const empty = document.querySelector<HTMLElement>('.overview .tv-empty');
    if (empty) empty.hidden = !!document.querySelector('.overview li');
    clock.textContent = clockFmt.format(new Date());
  }

  // Screen-print transitions, unless motion is reduced or ?fx=off.
  const fx = params.get('fx') !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches ? 'print' : '';
  if (fx) {
    document.getElementById('tv')!.dataset.fx = fx;
    document.querySelectorAll<HTMLElement>('.slide').forEach((s, n) => {
      s.style.setProperty('--tilt', n % 2 ? '0.5deg' : '-0.6deg');
      // --i staggers rows and lines within each group
      for (const group of s.querySelectorAll('ol, .info, .date-block, .overview-head')) {
        [...group.children].forEach((el, i) => (el as HTMLElement).style.setProperty('--i', String(i)));
      }
    });
  }
  let leaving = 0;

  let slides: HTMLElement[] = [];
  let index = 0;
  let timer = 0;
  let paused = false;

  function show(i: number) {
    const prev = document.querySelector<HTMLElement>('.slide.is-on');
    refresh();
    slides = [...document.querySelectorAll<HTMLElement>('.slide')];
    if (!slides.length) return;
    index = (i + slides.length) % slides.length;
    // The slide going out stays up for a beat so the next one can cover it.
    if (fx && prev && prev !== slides[index]) {
      document.querySelectorAll('.was-on').forEach((s) => s.classList.remove('was-on'));
      if (prev.isConnected) prev.classList.add('was-on');
      clearTimeout(leaving);
      leaving = window.setTimeout(() => prev.classList.remove('was-on'), 1600);
    }
    slides.forEach((s, n) => s.classList.toggle('is-on', n === index));
    // Restart the progress bar. Event mode's event slide stays up longer.
    const dwell = Number(slides[index].dataset.dwell) || SLIDE_MS;
    bar.classList.remove('run');
    void bar.offsetWidth;
    bar.style.animationDuration = `${dwell}ms`;
    if (!paused) bar.classList.add('run');
    clearTimeout(timer);
    if (!paused) timer = window.setTimeout(next, dwell);
  }

  function next() {
    // Reload between slides once an hour, to pick up new events. reload()
    // keeps the address, so event mode's ?event=… comes back as is.
    if (Date.now() - loadedAt > RELOAD_MS && index === slides.length - 1) return location.reload();
    // refresh() may remove ended slides, so step from where the current one
    // ends up rather than by position (which would skip a slide).
    const current = slides[index];
    refresh();
    const at = [...document.querySelectorAll<HTMLElement>('.slide')].indexOf(current);
    show(at < 0 ? index : at + 1);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1);
    else if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === ' ') { paused = !paused; show(index); e.preventDefault(); }
  });
  // The clock, and event mode's countdown, tick between slide changes too.
  setInterval(() => { clock.textContent = clockFmt.format(new Date()); mode?.update(Date.now()); }, 15_000);
  show(0);

  // Keep the screen from dimming or sleeping while the page is up (a laptop
  // driving a booth TV, say). Browsers drop the lock whenever the tab is
  // hidden, so ask again each time it comes back. Where it isn't supported,
  // or is refused, the slideshow just runs as before.
  async function stayAwake() {
    try { if (document.visibilityState === 'visible') await navigator.wakeLock?.request('screen'); } catch {}
  }
  stayAwake();
  document.addEventListener('visibilitychange', stayAwake);
</script>
