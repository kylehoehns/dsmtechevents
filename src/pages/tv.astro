---
// Lobby TV mode: full-screen posters of what's coming up, for a screen at a
// coworking space or a meetup venue. Linked from the About page, kept out
// of search. It reloads itself hourly to pick up the 4x-a-day data refresh.
//
// Slides: a "Coming up" overview, then one poster per event with a QR code
// to its Meetup (or conference) page. ← → step, space pauses.
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data.mjs';
import { weekday, day, month, shortRange, shortTime } from '../lib/format.mjs';
import { site } from '../lib/site.mjs';

const { upcoming, byId } = loadData();
const DAYS = 21;
const SHOWN = 10;
const horizon = Date.now() + DAYS * 86_400_000;
const soon = upcoming.filter((e) => !e.repeat && Date.parse(e.start) < horizon);
// Always show something, even in a quiet stretch.
const events = (soon.length >= 3 ? soon : upcoming.filter((e) => !e.repeat)).slice(0, SHOWN);

// On the overview slide: one code to the whole site.
const siteQr = await QRCode.toString(site.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1b2b', light: '#0000' } });

const slides = await Promise.all(events.map(async (e) => ({
  e,
  hosts: e.hostsLabel,
  where: e.online ? 'Online' : [e.venue, e.address].filter(Boolean).join(' · ') || 'Venue TBA',
  qr: e.url ? await QRCode.toString(e.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1b2b', light: '#0000' } }) : null,
})));
---
<Layout bare noindex headTitle={`TV · ${site.name}`}>
  <div class="tv" id="tv">
    <header class="tv-top">
      <span class="tv-logo misprint" data-t={site.name}>{site.name}</span>
      <span class="tv-site">{new URL(site.url).host}</span>
      <time class="tv-clock" id="tv-clock"></time>
    </header>

    <main class="tv-stage">
      <section class="slide overview is-on">
        <div class="overview-head">
          <h1 class="misprint" data-t="Coming up">Coming up</h1>
          <div class="qr site-qr">
            <div class="qr-code" set:html={siteQr} />
            <span>Every event</span>
          </div>
        </div>
        <p class="tv-empty" hidden>Nothing on the calendar right now. New events show up here as groups post them.</p>
        <ol>
          {slides.slice(0, 7).map(({ e, hosts }) => (
            <li class:list={{ headliner: e.headliner }} data-end={e.end}>
              <span class="row-date"><b>{weekday(e.start)}</b> {month(e.start)} {day(e.start)}</span>
              <span class="row-group">{hosts}</span>
              <span class="row-title">{e.title}</span>
              <span class="row-time">{e.multiDay && !e.allDay ? `${shortTime(e.start)}–${shortTime(e.end)}` : shortRange(e)}</span>
            </li>
          ))}
        </ol>
      </section>

      {slides.map(({ e, hosts, where, qr }) => (
        <section class:list={['slide', 'poster-slide', { headliner: e.headliner }]} data-end={e.end} data-start={e.start}>
          <div class="date-block">
            <span class="dow">{weekday(e.start)}</span>
            <span class="num misprint" data-t={day(e.start)}>{day(e.start)}</span>
            <span class="mon">{month(e.start)}</span>
            <span class="when-tag" hidden></span>
          </div>
          <div class="info">
            <p class="hosts">{hosts}</p>
            <h2>{e.title}</h2>
            <p class="time">{shortRange(e)}</p>
            <p class="where">{where}</p>
            {e.going > 0 && <p class="going"><b>{e.going}</b> going</p>}
          </div>
          {(e.photo || qr) && (
            <div class="tv-side">
              {e.photo && <img class="tv-photo" src={e.photo.large} alt="" />}
              {qr && (
                <div class="qr">
                  <div class="qr-code" set:html={qr} />
                  <span>{e.url.includes('meetup.com') ? 'Scan to RSVP' : 'Scan for details'}</span>
                </div>
              )}
            </div>
          )}
        </section>
      ))}
    </main>

    <div class="tv-progress"><span id="tv-bar"></span></div>
  </div>
</Layout>

<style is:global>
  /* The TV is always the dark flyer, whatever the device prefers. */
  html:has(.tv) { background: #141217; cursor: none; }
  .tv {
    --bg: #1d1c22; --ink: #ece6da; --soft: #bdb6aa; --pink: #e0609f; --blue: #93c2ff; --misprint: #c04f87;
    position: fixed; inset: 0; display: grid; grid-template-rows: auto 1fr auto;
    background: var(--bg); color: var(--ink); overflow: hidden;
    padding: 3vh 4vw 2vh; font-family: var(--sans);
    animation: tv-drift 600s ease-in-out infinite alternate; /* nudges everything a few px against burn-in */
  }
  @keyframes tv-drift { from { translate: -6px -4px; } to { translate: 6px 4px; } }
  .tv .misprint::before { color: var(--misprint); mix-blend-mode: normal; }
  .tv-top { display: flex; align-items: baseline; gap: 2vw; border-bottom: 3px solid #5d5966; padding-bottom: 1.2vh; }
  .tv-logo { font: 900 5vh/0.9 var(--display); text-transform: uppercase; color: var(--blue); }
  .tv-site { font: 700 2.2vh/1 var(--mono); color: var(--soft); }
  .tv-clock { margin-left: auto; font: 700 3vh/1 var(--mono); }

  .tv-stage { position: relative; min-height: 0; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.8s ease; display: flex; }
  .slide.is-on { opacity: 1; }

  .overview { flex-direction: column; gap: 2vh; padding-top: 3vh; }
  .overview-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 3vw; }
  .site-qr .qr-code svg { width: 13vh; height: 13vh; }
  .overview h1 { margin: 0; font: 900 9vh/0.85 var(--display); text-transform: uppercase; color: var(--ink); }
  .tv-empty { margin: 0; font: 600 3.4vh/1.3 var(--sans); color: var(--soft); }
  .overview ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4vh; }
  .overview li { display: grid; grid-template-columns: 14vw 14vw 1fr auto; align-items: baseline; gap: 2vw; padding-bottom: 1.2vh; border-bottom: 2px dashed #5d5966; font-size: 3.2vh; }
  .overview li.headliner .row-title { color: var(--pink); }
  .overview .row-date { font: 700 2.8vh/1 var(--mono); }
  .overview .row-date b { color: var(--blue); }
  .overview .row-group { font: 900 3.4vh/1 var(--display); text-transform: uppercase; color: var(--pink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .overview .row-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .overview .row-time { font: 600 2.6vh/1 var(--mono); color: var(--soft); }

  .poster-slide { align-items: center; gap: 4vw; padding: 3vh 0; }
  .poster-slide.headliner { background: var(--pink); color: #1d1b2b; margin: 2vh -4vw; padding: 3vh 4vw; }
  .date-block { display: flex; flex-direction: column; align-items: center; gap: 1.6vh; min-width: 16vw; }
  .date-block .dow, .date-block .mon { font: 900 6vh/1 var(--display); text-transform: uppercase; }
  .date-block .num { font: 900 30vh/0.8 var(--display); color: var(--blue); }
  .poster-slide.headliner .date-block .num { color: #1d1b2b; }
  .poster-slide.headliner .date-block .num::before { color: #0a6cc0; }
  .date-block .when-tag { margin-top: 2vh; font: 400 3.6vh/1 var(--marker); background: var(--pink); color: #1d1b2b; padding: 0.6vh 1vw 0.2vh; transform: rotate(-3deg); }
  .poster-slide.headliner .when-tag { background: #1d1b2b; color: var(--pink); }
  .info { flex: 1; min-width: 0; }
  .info .hosts { margin: 0 0 1vh; font: 900 6vh/0.95 var(--display); text-transform: uppercase; color: var(--pink); }
  .poster-slide.headliner .info .hosts { color: #1d1b2b; }
  .info h2 { margin: 0 0 2.5vh; font: 700 6.4vh/1.08 var(--sans); text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .info .time { margin: 0; font: 700 4vh/1.2 var(--mono); }
  .info .where { margin: 0.6vh 0 0; font: 500 3vh/1.3 var(--mono); color: var(--soft); }
  .poster-slide.headliner .info .where { color: inherit; }
  .info .going { margin: 2.5vh 0 0; font: 600 3vh/1 var(--mono); }
  .info .going b { font: 900 6vh/1 var(--display); vertical-align: -0.6vh; margin-right: 0.6vw; }
  .tv-side { display: flex; flex-direction: column; align-items: center; gap: 3vh; width: 28vw; }
  .tv-side .tv-photo { width: 100%; max-height: 38vh; object-fit: contain; border: 3px solid var(--ink); background: #000; transform: rotate(-1deg); }
  .qr { display: flex; flex-direction: column; align-items: center; gap: 1vh; background: #f3ede1; color: #1d1b2b; padding: 1.6vh; }
  .qr-code svg { display: block; width: 20vh; height: 20vh; }
  .qr span { font: 900 2.6vh/1 var(--display); text-transform: uppercase; }

  .tv-progress { height: 6px; background: #2c2a33; margin-top: 1.4vh; }
  .tv-progress span { display: block; height: 100%; width: 0; background: var(--pink); }
  .tv-progress span.run { animation: tv-bar linear forwards; }
  @keyframes tv-bar { to { width: 100%; } }

  @media (prefers-reduced-motion: reduce) {
    .tv { animation: none; }
    .slide { transition: none; }
  }
</style>

<script>
  import { fmt, whenLabel } from '../lib/format.mjs';

  const SLIDE_MS = 12_000;
  const RELOAD_MS = 60 * 60 * 1000;
  const loadedAt = Date.now();
  // The bare layout skips Layout's footer script, so register the service
  // worker here: a lobby screen that only ever opens /tv/ then has a saved copy
  // to fall back on if the Wi-Fi drops during the hourly reload.
  if ('serviceWorker' in navigator && import.meta.env.PROD) navigator.serviceWorker.register('/sw.js');
  const bar = document.getElementById('tv-bar')!;
  const clock = document.getElementById('tv-clock')!;
  const clockFmt = fmt({ weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  // The page is built ahead of time: drop anything that has ended, and label
  // today's and tomorrow's events.
  function refresh() {
    const now = Date.now();
    for (const el of document.querySelectorAll<HTMLElement>('[data-end]')) {
      if (el.dataset.end && Date.parse(el.dataset.end) <= now) el.remove();
    }
    for (const s of document.querySelectorAll<HTMLElement>('.poster-slide')) {
      const tag = s.querySelector<HTMLElement>('.when-tag')!;
      const label = whenLabel(s.dataset.start!, s.dataset.end!, now);
      tag.textContent = label;
      tag.hidden = !label;
    }
    const empty = document.querySelector<HTMLElement>('.tv-empty')!;
    empty.hidden = !!document.querySelector('.overview li');
    clock.textContent = clockFmt.format(new Date());
  }

  let slides: HTMLElement[] = [];
  let index = 0;
  let timer = 0;
  let paused = false;

  function show(i: number) {
    refresh();
    slides = [...document.querySelectorAll<HTMLElement>('.slide')];
    if (!slides.length) return;
    index = (i + slides.length) % slides.length;
    slides.forEach((s, n) => s.classList.toggle('is-on', n === index));
    // Restart the progress bar.
    bar.classList.remove('run');
    void bar.offsetWidth;
    bar.style.animationDuration = `${SLIDE_MS}ms`;
    if (!paused) bar.classList.add('run');
    clearTimeout(timer);
    if (!paused) timer = window.setTimeout(next, SLIDE_MS);
  }

  function next() {
    // Reload between slides once an hour, to pick up new events.
    if (Date.now() - loadedAt > RELOAD_MS && index === slides.length - 1) return location.reload();
    // refresh() may remove ended slides, so step from where the current one
    // ends up rather than by position (which would skip a slide).
    const current = slides[index];
    refresh();
    const at = [...document.querySelectorAll<HTMLElement>('.slide')].indexOf(current);
    show(at < 0 ? index : at + 1);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1);
    else if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === ' ') { paused = !paused; show(index); e.preventDefault(); }
  });
  setInterval(() => { clock.textContent = clockFmt.format(new Date()); }, 15_000);
  show(0);

  // Keep the screen from dimming or sleeping while the page is up (a laptop
  // driving a booth TV, say). Browsers drop the lock whenever the tab is
  // hidden, so ask again each time it comes back. Where it isn't supported,
  // or is refused, the slideshow just runs as before.
  async function stayAwake() {
    try { if (document.visibilityState === 'visible') await navigator.wakeLock?.request('screen'); } catch {}
  }
  stayAwake();
  document.addEventListener('visibilitychange', stayAwake);
</script>
