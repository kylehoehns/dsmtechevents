---
import OutArrow from '../components/OutArrow.astro';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import { loadData } from '../lib/data.mjs';
import { splitEvents } from '../lib/pool.mjs';
import { eventJsonLd, websiteJsonLd, toScript } from '../lib/jsonld.mjs';
import { dayKey, lastDay, weekday, day, month, shortTime, addDays, daysBetween, monthName, plural, countdown, dayOf, dateRange, recentSummary } from '../lib/format.mjs';

const { events, upcoming, past, endingSoon, groups, byId, updatedAt } = loadData();

// Section labels are relative to the build, which runs at least once a day
// (see refresh.yml); the browser re-labels Today/Tonight/Tomorrow itself.
// Full rows through the end of next month, a compact set list after that.
// Repeat dates and past events get their cards in the card pool (/cards/,
// fetched by the calendar) instead: see lib/pool.mjs.
const { today, listed, near, far } = splitEvents({ upcoming, past });
const dow = new Date(`${today}T12:00:00Z`).getUTCDay();
const thisWeekEnd = addDays(today, (7 - dow) % 7);
const nextWeekEnd = addDays(thisWeekEnd, 7);

function sectionOf(key: string) {
  if (key <= thisWeekEnd) return 'This week';
  if (key <= nextWeekEnd) return 'Next week';
  if (key.slice(0, 7) === today.slice(0, 7)) return `Rest of ${monthName(key, false)}`;
  return monthName(key, key.slice(0, 4) !== today.slice(0, 4));
}
const sections: { title: string; items: typeof near }[] = [];
for (const e of near) {
  const title = sectionOf(dayKey(e.start));
  if (sections.at(-1)?.title !== title) sections.push({ title, items: [] });
  sections.at(-1)!.items.push(e);
}
// Conferences get poster treatment only when they're close. Further out,
// they're just a pink row at their date in the list. A poster stays up
// until its conference is over.
const HEADLINER_DAYS = 30;
const DAYS_WORD = ['One', 'Two', 'Three', 'Four', 'Five'];
const conferenceLength = (e: any) => { const n = daysBetween(dayKey(e.start), lastDay(e.start, e.end)) + 1; return `${DAYS_WORD[n - 1] ?? n}-day conference`; };
const headliners = upcoming.filter((e) => e.headliner && daysBetween(today, dayKey(e.start)) <= HEADLINER_DAYS);
// Each poster is taped up its own way: a small tilt and where its tape sits,
// from a hash of the event id, so a poster looks the same on every visit and
// a third one doesn't copy the first. Ink (pink, blue) still alternates.
function posterLook(id: string) {
  let h = 2166136261; // FNV-1a
  for (const c of id) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
  const unit = (shift: number) => ((h >>> shift) & 0xff) / 255; // 0..1, from 8 bits of the hash
  const sign = h & 1 ? 1 : -1;
  return [
    `--tilt: ${(sign * (0.3 + unit(1) * 0.7)).toFixed(2)}deg`, // 0.3-1deg either way
    `--tape-x: ${(32 + unit(9) * 36).toFixed(1)}%`, // the tape's middle, 32-68% across
    `--tape-w: ${Math.round(82 + unit(17) * 16)}px`,
    `--tape-rot: ${(-sign * (1.5 + unit(24) * 3)).toFixed(1)}deg`, // leans against the tilt
  ].join('; ');
}

// Recent events shows the last few; "+ All N" opens the rest (90 days' worth).
const PAST_SHOWN = 3;
// Events ending in the next day or two are there too, hidden until they're
// over (data-after; app.js), so one doesn't vanish between the list and here.
const recentRows = [...endingSoon, ...past].sort((a, b) => b.start.localeCompare(a.start));

const calendarData = {
  events: events.map((e) => ({
    id: e.id, title: e.title, url: e.url, start: e.start, end: e.end, groups: e.groupIds, headliner: e.headliner, allDay: e.allDay,
  })),
  groups: Object.fromEntries(groups.map((g) => [g.id, { name: g.name, short: g.short, url: g.meetupUrl ?? g.website ?? null }])),
};
// Structured data for the events the list shows (not the card pool, which
// holds past events and repeat dates).
const structured = [websiteJsonLd(), ...listed.map((e) => eventJsonLd(e, byId)).filter(Boolean)];
---
<Layout updatedAt={updatedAt} search
  headTitle="DSM Tech Events: Des Moines tech meetups and conferences"
  description="Every upcoming Des Moines tech meetup, user group and conference in one list: Python, Java, .NET, AI, AWS, security, UX and more. Updated daily.">
  <script type="application/ld+json" set:html={toScript(structured)} />
  <h1 class="sr-only">Upcoming tech events in Des Moines</h1>
  <p class="sr-only" role="status" id="status"></p>
  <div class="layout">
    {/* Headliners come first in the page so phones read and tab them in the
        order they show. On desktop the grid puts them in the side rail (see
        .layout in global.css). */}
    <div class="lead">
      {headliners.length > 0 && (
        <section class="headliners" id="headliners" aria-label="Coming up soon">
          {headliners.map((e, i) => { const stamp = countdown(e.start, e.end, Date.now(), e); return (
            <article class:list={['poster', { blue: i % 2 }]} style={posterLook(e.id)} data-end={e.end} data-groups={e.groupIds.join(' ')} data-id={e.id}>
              <div class="poster-full">
                <span class="tape" aria-hidden="true" />
                <div class="bill"><span>Headliner</span><span>{conferenceLength(e)}</span></div>
                <h2>{e.title}</h2>
                <p class="when">{e.multiDay ? dateRange(e.start, e.end) : `${weekday(e.start)} ${month(e.start)} ${day(e.start)}`}</p>
                {/* On the day itself the hand-lettered note gives way to a pasted-up strip (app.js re-checks both). */}
                <span class:list={['stamp-days', 'countdown', { 'day-of': dayOf(stamp) }]} data-start={e.start} data-end={e.end} data-days={e.multiDay && !e.allDay ? '' : undefined}>{stamp}</span>
                <p class="where">{e.venue}{e.address && <><br />{e.address}</>}</p>
                <a class="go btn btn-outline" href={e.url} target="_blank" rel="noopener" data-click="poster">RSVP & info<span class="sr-only">: {e.title} (opens in new tab)</span> <OutArrow /></a>
              </div>
            </article>
          ); })}
        </section>
      )}

      {/* desktop only; phones hide it */}
      <section class="minical" id="minical" aria-label="This month"></section>

      {/* Shows only while filtered to one group (?group=id, reached from a group
          name on a card or the Groups page). Search is the way in otherwise. */}
      <div class="filter" id="filter" hidden>
        <p class="filter-note" id="filter-note"></p>
      </div>
    </div>

    <div class="main">
      <section id="list-view" aria-label="Upcoming events">
        {sections.map((s) => (
          <section class="sec" data-sec>
            <div class="sec-head"><h2>{s.title}</h2><span class="count" data-count>{plural(s.items.length, 'event')}</span></div>
            <ul class="shows">{s.items.map((e) => <EventCard event={e} byId={byId} posted={headliners.some((h) => h.id === e.id)} />)}</ul>
          </section>
        ))}
        {far.length > 0 && (
          <section class="sec" data-sec>
            <div class="sec-head"><h2>Further out</h2><span class="count" data-count>{far.length} on the books</span></div>
            <ol class="setlist far">
              {far.map((e) => (
                <li data-groups={e.groupIds.join(' ')} data-end={e.end} data-id={e.id}>
                  <span class="row-date">{month(e.start)} {day(e.start)}</span>
                  <a href={e.url} target="_blank" rel="noopener" data-click="later">
                    <span class="row-group">{e.hostsLabel}{e.back && <> <span class="back-tag">Back!</span></>}</span>
                    {e.series &&<span class="row-series">{e.series.rule} · {e.series.count} dates</span>}
                    <span class="row-title">{e.title}</span>
                    <span class="row-where">{e.allDay ? 'All day' : shortTime(e.start)} · {e.online ? 'Online' : `@ ${e.venue ?? 'Venue TBA'}`}</span>
                    <span class="sr-only"> (opens in new tab)</span>
                  </a>
                  <span class="row-going">{e.going ? <><b>{e.going}</b> going</> : ''}</span>
                </li>
              ))}
            </ol>
          </section>
        )}
        <p class="empty" id="list-empty" hidden>Nothing on the books for this group right now. Check their page for what's next.</p>
      </section>

      {/* A search's past matches, newest first. The rows come with the card
          pool (/cards/), which a search fetches, so they cost the page nothing. */}
      <section class="sec past-results" id="past-results" aria-labelledby="past-h" hidden>
        <div class="sec-head"><h2 id="past-h">Past</h2><span class="count" data-count></span></div>
        <ol class="setlist far"></ol>
      </section>

      <section id="calendar-view" aria-label="Calendar" hidden></section>
    </div>

    <aside class="side" aria-label="Day details and recent events">
      <section class="day-panel" id="day-panel" hidden></section>

      <section class="recent" id="recent" aria-labelledby="recent-h">
        <h2 id="recent-h">Recent events</h2>
        <p class="sub" id="recent-sub">{recentSummary(past.length, past.reduce((n, e) => n + (e.going ?? 0), 0))}</p>
        <ol class="setlist" id="recent-list" data-shown={PAST_SHOWN}>
          {recentRows.map((e) => (
            <li class:list={{ extra: past.indexOf(e) >= PAST_SHOWN }} data-groups={e.groupIds.join(' ')} data-id={e.id} data-going={e.going ?? 0} data-after={endingSoon.includes(e) ? e.end : undefined} hidden={endingSoon.includes(e)}>
              <span class="row-date">{month(e.start)} {day(e.start)}</span>
              <a href={e.url} target="_blank" rel="noopener" data-click="past">
                <span class="row-group">{e.hostsLabel}</span>
                <span class="row-title">{e.title}</span>
                <span class="row-where">{e.online ? 'Online' : e.venue ? `@ ${e.venue}` : ''}</span>
                <span class="sr-only"> (opens in new tab)</span>
              </a>
              <span class="row-going">{e.going ? <><b>{e.going}</b> went</> : ''}</span>
            </li>
          ))}
        </ol>
        {recentRows.length > PAST_SHOWN && <button type="button" class="all btn btn-outline" id="recent-all" aria-expanded="false">+ All {past.length}</button>}
      </section>
    </aside>
  </div>

  {/* toScript escapes "<", so an event title can't close this tag. */}
  <script type="application/json" id="calendar-data" set:html={toScript(calendarData)} />
  <script>import '../scripts/app.js';</script>
</Layout>
