---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../lib/site.mjs';
import { month, day, shortTime } from '../lib/format.mjs';

// headTitle replaces the whole <title> (for search); title gets " · DSM Tech Events".
// bare: just the page itself (fonts and head, no masthead, footer or their scripts), for /tv/.
// search: the events page's search button and box (app.js runs them). Every
// other page gets the same button as a link to /?search, so the nav row never
// shifts between pages and search works from anywhere.
interface Props { bare?: boolean; search?: boolean; title?: string; headTitle?: string; description?: string; noindex?: boolean; nav?: 'list' | 'calendar' | 'groups' | 'add' | 'about' | null; updatedAt?: string; blurb?: string }
const { bare = false, search = false, title, headTitle, description = site.tagline, noindex = false, nav = 'list', updatedAt, blurb } = Astro.props;
const pageTitle = headTitle ?? (title ? `${title} · ${site.name}` : site.name);
// Same time style as the event list: "Oct 8, 5:52a".
const updated = updatedAt && `${month(updatedAt)} ${day(updatedAt)}, ${shortTime(updatedAt)}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {/* ?v= changes whenever the image does: Slack and Messages cache previews by URL. */}
    <meta property="og:image" content={new URL('/og-image-dark.png?v=3', site.url).href} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`${site.name}: meetups, user groups and conferences in Des Moines, Iowa`} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Event photos come from Meetup; start that connection early. The service
        worker fetches them anonymously (CORS), hence crossorigin. */}
    <link rel="preconnect" href="https://secure.meetupstatic.com" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3ede1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141217" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="DSM Tech" />
    {/* Self-hosted fonts (see astro.config.mjs). Only the logo's face is
        preloaded: it is the biggest thing on screen. */}
    <Font cssVariable="--display" preload={[{ weight: 900 }]} />
    <Font cssVariable="--mono" />
    <Font cssVariable="--sans" />
    <Font cssVariable="--marker" />
    <script is:inline>
      // Apply a saved light/dark choice before first paint. No choice = follow the device.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
      // A shared calendar link hides the list before first paint, so it never
      // flashes up and then jumps away. app.js keeps this in sync after that.
      if (new URLSearchParams(location.search).get('view') === 'calendar') document.documentElement.dataset.view = 'calendar';
    </script>
  </head>
  <body>
    {bare ? <slot /> : <>
    <a class="sr-only skip" href="#main">Skip to content</a>
    <header class="mast">
      <div class="wrap">
        <div class="mast-body">
          <div class="mast-row">
            <a class="logo" href="/" aria-label={`${site.name} home`}><span class="misprint" data-t={site.name}>{site.name}</span></a>
            <div class="mast-tools">
              {nav !== null && (
              <nav class="nav" aria-label="Main">
                <a href="/" data-nav="list" aria-current={nav === 'list' ? 'page' : undefined}>Events</a>
                <a href="/?view=calendar" data-nav="calendar" aria-current={nav === 'calendar' ? 'page' : undefined}>Calendar</a>
                <a href="/groups/" data-nav="groups" aria-current={nav === 'groups' ? 'page' : undefined}>Groups</a>
              </nav>
              )}
              {/* /?view=calendar is the same page as the list, built with Events as
                  the current tab; fix the tab now, before first paint, rather than
                  when app.js runs (which made Events flash on). */}
              {nav === 'list' && (
              <script is:inline>
                if (document.documentElement.dataset.view === 'calendar') {
                  document.querySelector('[data-nav="list"]').removeAttribute('aria-current');
                  document.querySelector('[data-nav="calendar"]').setAttribute('aria-current', 'page');
                }
              </script>
              )}
              <div class="mast-btns">
              {search ? (
              <button type="button" class="icon-btn" id="search-btn" aria-label="Search events" title="Search events" aria-expanded="false" aria-controls="search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.2" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="M15.2 15.2l5.6 5.6" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" /></svg>
              </button>
              ) : (
              <a class="icon-btn" href="/?search" aria-label="Search events" title="Search events">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.2" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="M15.2 15.2l5.6 5.6" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" /></svg>
              </a>
              )}
              {/* Icon follows <html data-theme> in CSS, so it's right before any script runs. */}
              <button type="button" class="icon-btn theme-btn" id="theme-btn" aria-label="Theme: auto" title="Theme: auto">
                <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></svg>
                <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 1 1 9.4 4a6.6 6.6 0 0 0 10.6 10.6z" fill="currentColor" /></svg>
              </button>
              </div>
            </div>
          </div>
          {search && (
          <form class="search" id="search" role="search" hidden>
            <input type="search" id="q" name="q" aria-label="Search events" placeholder="Group, topic, venue or town" autocomplete="off" enterkeyhint="search" spellcheck="false" />
            <button type="button" class="btn btn-outline" id="search-clear" aria-label="Clear search">×</button>
          </form>
          )}
          {blurb && <p class="blurb" set:html={blurb} />}
        </div>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        {nav !== 'add' ? (
        <div>
          <p class="big"><a href="/add/">Add your group or event →</a></p>
          <p style="margin-top:10px">Run a tech meetup, conference or one-off event in central Iowa? Here's how to get it listed.</p>
        </div>
        ) : <div />}
        <div class="fine">
          {updated && <p>Last updated {updated}.</p>}
          <p>All times Central. <a href="/about/">About this site</a></p>
          <p><a href="/tv/">Put it on a TV</a> · <a href="/print/">Print a flyer</a></p>
          <button type="button" class="install-app btn btn-solid" id="install-app" hidden>Install as an app</button>
        </div>
      </div>
    </footer>

    <div class="install-hint" id="install-hint" hidden>
      <span>Install this on your phone: tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>.</span>
      <button type="button" aria-label="Dismiss">✕</button>
    </div>

    <script>
      const store = {
        get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
        set: (k: string, v: string | null) => { try { v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} },
      };

      // Theme: auto (follow the device) -> light -> dark -> auto.
      const themeBtn = document.getElementById('theme-btn')!;
      const showTheme = () => {
        const label = `Theme: ${store.get('theme') ?? 'auto'}`;
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
      };
      themeBtn.addEventListener('click', () => {
        const modes = ['auto', 'light', 'dark'];
        const next = modes[(modes.indexOf(store.get('theme') ?? 'auto') + 1) % modes.length];
        store.set('theme', next === 'auto' ? null : next);
        if (next === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = next;
        showTheme();
      });
      showTheme();

      // Count outbound clicks (docs/ANALYTICS.md): which kind of link, which
      // group(s), which event. Nothing about the visitor. sendBeacon survives
      // the page being left, and a failure never gets in the way of the link.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element).closest<HTMLElement>('[data-click]');
        if (!a || !import.meta.env.PROD) return;
        const host = a.closest<HTMLElement>('[data-groups]');
        const body = { kind: a.dataset.click, groups: host?.dataset.groups?.split(' ').filter(Boolean) ?? [], event: a.closest<HTMLElement>('[data-id]')?.dataset.id ?? '' };
        try { navigator.sendBeacon('/api/click', JSON.stringify(body)); } catch {}
      });

      if ('serviceWorker' in navigator && import.meta.env.PROD) navigator.serviceWorker.register('/sw.js');

      // An installed app can be resumed days later without reloading. If the page
      // is over an hour old when it comes back, reload it so events and the
      // "Tomorrow" labels are current.
      const loadedAt = Date.now();
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && Date.now() - loadedAt > 60 * 60 * 1000) location.reload();
      });

      // Android Chrome offers to install the site as an app; keep that offer
      // and put it behind a button in the footer instead of a pop-up.
      const installBtn = document.getElementById('install-app') as HTMLButtonElement;
      let installOffer: any = null;
      window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installOffer = e; installBtn.hidden = false; });
      window.addEventListener('appinstalled', () => { installBtn.hidden = true; installOffer = null; });
      installBtn.addEventListener('click', async () => {
        if (!installOffer) return;
        installOffer.prompt();
        await installOffer.userChoice;
        installOffer = null;
        installBtn.hidden = true;
      });

      // iOS has no install prompt, so show a one-time hint in Safari.
      const hint = document.getElementById('install-hint')!;
      const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !standalone && store.get('install-hint') !== 'dismissed') {
        hint.hidden = false;
        // Keep focused elements from scrolling under the fixed hint.
        document.documentElement.classList.add('has-hint');
        hint.querySelector('button')!.addEventListener('click', () => {
          hint.hidden = true; store.set('install-hint', 'dismissed');
          document.documentElement.classList.remove('has-hint');
        });
      }
    </script>
    </>}
  </body>
</html>
