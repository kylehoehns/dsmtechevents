---
import '../styles/global.css';
import { site } from '../lib/site.mjs';

interface Props { title?: string; nav?: 'list' | 'calendar' | 'groups' | null; updatedAt?: string; blurb?: string }
const { title, nav = 'list', updatedAt, blurb } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const fmt = (opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-US', { timeZone: site.timeZone, ...opts });
const updated = updatedAt && fmt({ month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(updatedAt));
const canonical = new URL(Astro.url.pathname, site.url).href;
const builtOn = fmt({ weekday: 'short', month: 'short', day: 'numeric' }).format(new Date());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.tagline} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:image" content={new URL('/og-image-dark.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: meetups, user groups and conferences in Des Moines, Iowa`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3ede1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141217" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="DSM Tech" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Permanent+Marker&display=swap" />
    <script is:inline>
      // Apply a saved light/dark choice before first paint. No choice = follow the device.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only skip" href="#main">Skip to events</a>
    <header class="mast">
      <div class="wrap">
        <div class="mast-top">
          <span><b>Des Moines, IA</b> · 515 · {builtOn}</span>
          <button type="button" class="theme-btn" id="theme-btn">Theme: auto</button>
        </div>
        <div class="mast-body">
          <div class="mast-row">
            <a class="logo" href="/" aria-label={`${site.name} home`}><span class="mis" data-t={site.name}>{site.name}</span></a>
            {nav !== null && (
            <nav class="nav" aria-label="Main">
              <a href="/" data-nav="list" aria-current={nav === 'list' ? 'page' : undefined}>Events</a>
              <a href="/?view=calendar" data-nav="calendar" aria-current={nav === 'calendar' ? 'page' : undefined}>Calendar</a>
              <a href="/groups/" data-nav="groups" aria-current={nav === 'groups' ? 'page' : undefined}>Groups</a>
            </nav>
            )}
          </div>
          {blurb && <p class="blurb" set:html={blurb} />}
        </div>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div>
          <p class="big"><a href={site.repo + '#adding-things'}>Add your group →</a></p>
          <p style="margin-top:10px">Run a tech meetup in central Iowa? We'll list it.</p>
        </div>
        <div class="fine">
          {updated && <p>Last updated {updated}.</p>}
          <p>All times Central.</p>
        </div>
      </div>
    </footer>

    <div class="install-hint" id="install-hint" hidden>
      <span>Install this on your phone: tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>.</span>
      <button type="button" aria-label="Dismiss">✕</button>
    </div>

    <script>
      const store = {
        get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
        set: (k: string, v: string | null) => { try { v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} },
      };

      // Theme: auto (follow the device) -> light -> dark -> auto.
      const themeBtn = document.getElementById('theme-btn')!;
      const showTheme = () => { themeBtn.textContent = `Theme: ${store.get('theme') ?? 'auto'}`; };
      themeBtn.addEventListener('click', () => {
        const next = ({ light: 'dark', dark: null } as Record<string, string | null>)[store.get('theme') ?? ''] ?? 'light';
        store.set('theme', next);
        if (next) document.documentElement.dataset.theme = next; else delete document.documentElement.dataset.theme;
        showTheme();
      });
      showTheme();

      if ('serviceWorker' in navigator && import.meta.env.PROD) navigator.serviceWorker.register('/sw.js');

      // An installed app can be resumed days later without reloading. If the page
      // is over an hour old when it comes back, reload it so events and the
      // "Tomorrow" labels are current.
      const loadedAt = Date.now();
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && Date.now() - loadedAt > 60 * 60 * 1000) location.reload();
      });

      // iOS has no install prompt, so show a one-time hint in Safari.
      const hint = document.getElementById('install-hint')!;
      const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !standalone && store.get('install-hint') !== 'dismissed') {
        hint.hidden = false;
        // Keep focused elements from scrolling under the fixed hint.
        document.documentElement.classList.add('has-hint');
        hint.querySelector('button')!.addEventListener('click', () => {
          hint.hidden = true; store.set('install-hint', 'dismissed');
          document.documentElement.classList.remove('has-hint');
        });
      }
    </script>
  </body>
</html>
