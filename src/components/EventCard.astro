---
// One event, printed like a show on a venue's listings sheet. Used by the list,
// and cloned by the calendar's day panel, so both always look the same.
//
// Anything that would repeat is left out: the photo square only appears for a
// real event photo (not the group's logo), the group's full name only when it
// says more than its short name, and the browser hides the date and street
// address when the row above already showed them (see app.js).
import { weekday, day, month, shortRange, formatDescription, dayKey, whenLabel } from '../lib/format.mjs';

const { event: e, byId } = Astro.props;
const hosts = e.groupIds.map((id: string) => byId[id]).filter(Boolean);
const lead = hosts[0];
const isMeetup = e.url?.includes('meetup.com');
const cta = isMeetup ? 'RSVP on Meetup' : e.headliner ? 'Tickets & info' : 'Details';
const descId = `about-${e.id.replace(/[^a-z0-9-]/gi, '')}`;
// Meetup photos come as small webp copies (see meetupPhoto). Most are 16:9 at
// 600x338; width/height hold that shape until the image arrives.
const photo = e.photo;
const thumbSrcset = photo && photo.small !== photo.large ? `${photo.small} 180w, ${photo.large} 600w` : undefined;
// "Tomorrow" / "Tonight" as of the build, so the tag is in the page from the
// start and nothing moves when app.js re-checks it against the real date.
const whenTag = whenLabel(e.start, e.end);
// Tapping the venue opens a map search (app.js switches it to Apple Maps on iPhones).
const mapQuery = [e.venue, e.fullAddress ?? e.address ?? 'Des Moines, IA'].filter(Boolean).join(', ');
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---
<li
  class:list={['show', { headliner: e.headliner, 'has-photo': !!e.photo }]}
  data-id={e.id}
  data-groups={e.groupIds.join(' ')}
  data-start={e.start}
  data-end={e.end}
  data-day={dayKey(e.start)}
  data-venue={e.venueKey}
>
  <div class="date" aria-hidden="true">
    <span class="dow">{weekday(e.start)}</span>
    <span class="num mis" data-t={day(e.start)}>{day(e.start)}</span>
    <span class="mon">{month(e.start)}</span>
  </div>

  {e.photo && (
    <div class="photo" aria-hidden="true">
      <div class="ink"><img src={photo.large} srcset={thumbSrcset} sizes="160px" width="600" height="338" alt="" loading="lazy" decoding="async" /></div>
    </div>
  )}

  <div class="body">
    <span class="when-tag" hidden={!whenTag}>{whenTag}</span>
    <p class="band">
      {hosts.length
        ? hosts.map((g: any, i: number) => (
            <>
              {i > 0 && <span class="with">w/</span>}
              <a href={`/?group=${g.id}`} data-group={g.id}>{g.short}</a>
            </>
          ))
        : <span class="b">{e.tags.includes('conference') ? 'Headliner · conference' : 'Community event'}</span>}
      {hosts.length === 1 && lead.showFullName && <span class="with">{lead.name}</span>}
    </p>
    {e.series && (
      <p class="series"><b>{e.series.rule}</b>{e.series.count} dates through {e.series.until}</p>
    )}
    <h3 class="title">{e.url ? <a href={e.url} target="_blank" rel="noopener" data-click="title" aria-label={`${e.title} (opens in new tab)`}>{e.title}</a> : e.title}</h3>
    <p class="meta">
      <span class="sr-only">{weekday(e.start)} {month(e.start)} {day(e.start)}, </span>
      <span class="t">{shortRange(e)}</span>
      {' · '}
      {e.online
        ? <span class="tag-online">Online</span>
        : e.venue
          ? <>@ <a class="map" href={mapUrl} data-q={mapQuery} data-click="map" target="_blank" rel="noopener">{e.venue}{e.address && <span class="addr">, {e.address}</span>}<span class="sr-only"> (open in maps)</span></a></>
          : <>@ Venue TBA</>}
      {e.hybrid && <> · <span class="tag-online">+ online</span></>}
    </p>
  </div>

  <div class="acts">
    {e.going > 0 && <span class="going"><b>{e.going}</b> going</span>}
    {e.url && <a class="rsvp" href={e.url} target="_blank" rel="noopener" data-click="rsvp" aria-label={`${cta}: ${e.title} (opens in new tab)`}>{cta} <span aria-hidden="true">→</span></a>}
    {(e.description || e.photo) && <button type="button" class="more" aria-expanded="false" aria-controls={descId}>About<span class="sr-only"> {e.title}</span></button>}
  </div>
  {(e.description || e.photo) && (
    <div class="desc" id={descId} hidden>
      {/* Phones hide the photo square, so the full-size flyer lives here. */}
      {e.photo && <img class="desc-photo" src={photo.large} width="600" height="338" alt={`Event image for ${e.title}`} loading="lazy" decoding="async" />}
      {e.description && <Fragment set:html={formatDescription(e.description)} />}
    </div>
  )}
</li>
