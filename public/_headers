# Cloudflare already serves every file with max-age=0, must-revalidate. The
# no-cache rules below spell it out for the pages that change several times a
# day and for sw.js, which can't replace itself if a stale copy is held.
#
# CSP: Cloudflare Web Analytics loads its beacon from static.cloudflareinsights.com
# and reports to cloudflareinsights.com. connect-src also covers fetch() inside
# sw.js, which pulls Meetup event photos from secure.meetupstatic.com.
# script-src: the inline-script-hashes source is a placeholder. scripts/csp.mjs replaces
# it in dist/_headers with the sha256 of each inline script in the built pages,
# so only those inline scripts run (no 'unsafe-inline').
# There is deliberately no default-src or img-src: event photos and logos come
# from Meetup, group sites (iowansofthings.com) and TAI, and that list grows.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: script-src 'self' 'inline-script-hashes' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://secure.meetupstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

/
  Cache-Control: no-cache

# The workers.dev address serves the same site; keep it out of search results.
https://dsmtechevents.kyhoehns.workers.dev/*
  X-Robots-Tag: noindex

/groups/
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Astro content-hashes everything it emits here, so a changed file gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
