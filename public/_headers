# Pages and the service worker must never be held by a cache: the site changes
# several times a day, and a stale sw.js can't be replaced by a newer one it never fetches.
#
# CSP: Cloudflare Web Analytics loads its beacon from static.cloudflareinsights.com
# and reports to cloudflareinsights.com. connect-src also covers fetch() inside
# sw.js, which pulls Meetup event photos from secure.meetupstatic.com.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://secure.meetupstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000

/
  Cache-Control: no-cache

# The workers.dev address serves the same site; keep it out of search results.
https://dsmtechevents.kyhoehns.workers.dev/*
  X-Robots-Tag: noindex

/groups/
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Astro content-hashes everything it emits here, so a changed file gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
