{
  // Static-asset Worker, connected to `main` with Workers Builds. It serves
  // `dist/`, which `astro build` makes from the repo, including the event data
  // committed to data/cache/. Cloudflare never fetches events itself: the
  // GitHub Action (.github/workflows/refresh.yml, four times a day) does, and its commit
  // is what triggers a deploy. So what is live is always exactly what is in git.
  //
  // Dashboard settings (Workers & Pages → dsmtechevents → Settings → Build).
  // The build command stays empty because both wrangler commands run `build`
  // below; filling it in just builds twice. Each PR branch gets a Preview
  // named after the branch.
  //   Production tab:    Build command (empty), Deploy command
  //                      `npx wrangler deploy`, Root `/`, Branch `main`
  //   Previews Base tab: Build command (empty), Preview command
  //                      `npx wrangler preview`
  // On the Previews Base tab, `wrangler versions upload` in either box fails
  // with "The name in your wrangler.jsonc file (dsmtechevents) must match the
  // name of your Worker"; previews need `wrangler preview`.
  // The Cloudflare GitHub app must have access to this repo, or pushes never
  // build (that was the outage on 2026-10-07).
  "name": "dsmtechevents",
  "compatibility_date": "2026-09-01",
  // A tiny Worker counts outbound clicks at /api/click (worker/index.js).
  // Only /api/* reaches it; every other request is a static file served
  // straight from `assets`, as before.
  "main": "worker/index.js",
  "build": { "command": "npm run build" },
  // dsmtechevents.kyhoehns.workers.dev stays up alongside dsmtechevents.com, and every
  // branch push gets a preview URL. Both are wrangler's defaults; declaring
  // them here silences the deploy warning and keeps them from changing.
  "workers_dev": true,
  "preview_urls": true,
  // `wrangler preview` (the Previews Base command) refuses to run without
  // this block. Previews don't inherit the bindings below, so they get their
  // own: a separate dataset and rate-limit counter, so testing a preview
  // never adds rows to the real click counts.
  "previews": {
    "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "dsmtechevents_clicks_preview" }],
    "ratelimits": [{ "name": "CLICK_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }]
  },
  "assets": {
    "directory": "dist",
    // /groups serves /groups/index.html; unknown paths get the real 404 page
    // rather than the home page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Click counts land in Workers Analytics Engine; see docs/ANALYTICS.md for
  // how to query them.
  "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "dsmtechevents_clicks" }],
  // Caps how fast one visitor can post clicks (worker/index.js). Counters are
  // in memory per Cloudflare location and never stored.
  "ratelimits": [{ "name": "CLICK_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Declared here, not toggled in the dashboard: every deploy reconciles the
  // Worker against this file, so a dashboard-only setting gets reset.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
